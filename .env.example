# Copy to .env.local and fill in. Required vars are validated at boot (app/libs/env.ts).

# --- Required ---
MONGODB_URI=mongodb://localhost:27017/finflow
NEXTAUTH_SECRET=        # generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_URL=http://localhost:3000
FINNHUB_API_KEY=        # https://finnhub.io  (NOTE: canonical name is FINNHUB_API_KEY)

# --- Optional (features degrade gracefully when unset) ---
# Upstash Redis — rate limiting + Finnhub price caching. https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Stripe — card tokenization. https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# Cron — protects /api/cron/process-transfers (Vercel Cron sends this as a Bearer token)
CRON_SECRET=
